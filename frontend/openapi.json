{
  "openapi": "3.1.0",
  "info": {
    "title": "Chronicler",
    "version": "1.0.0",
    "description": ""
  },
  "paths": {
    "/api/chronicles/": {
      "get": {
        "operationId": "gm_ui_api_list_chronicles",
        "summary": "List Chronicles",
        "parameters": [],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/ChronicleSummary"
                  },
                  "title": "Response",
                  "type": "array"
                }
              }
            }
          }
        }
      }
    },
    "/api/chronicles/{chronicle_id}": {
      "get": {
        "operationId": "gm_ui_api_get_chronicle",
        "summary": "Get Chronicle",
        "parameters": [
          {
            "in": "path",
            "name": "chronicle_id",
            "schema": {
              "title": "Chronicle Id",
              "type": "integer"
            },
            "required": true
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChronicleDetail"
                }
              }
            }
          }
        }
      }
    },
    "/api/chronicles/{chronicle_id}/beats": {
      "get": {
        "operationId": "gm_ui_api_list_beats",
        "summary": "List Beats",
        "parameters": [
          {
            "in": "path",
            "name": "chronicle_id",
            "schema": {
              "title": "Chronicle Id",
              "type": "integer"
            },
            "required": true
          },
          {
            "in": "query",
            "name": "audience",
            "schema": {
              "default": "all",
              "title": "Audience",
              "type": "string"
            },
            "required": false
          },
          {
            "in": "query",
            "name": "t",
            "schema": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "title": "T"
            },
            "required": false
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/BeatSummary"
                  },
                  "title": "Response",
                  "type": "array"
                }
              }
            }
          }
        },
        "description": "The beats `audience` (\"all\", \"table\" or a player id) had seen up to t (default: the latest)."
      }
    }
  },
  "components": {
    "schemas": {
      "ChronicleSummary": {
        "properties": {
          "id": {
            "title": "Id",
            "type": "integer"
          },
          "title": {
            "title": "Title",
            "type": "string"
          },
          "kind": {
            "title": "Kind",
            "type": "string"
          },
          "beat_count": {
            "title": "Beat Count",
            "type": "integer"
          }
        },
        "required": ["id", "title", "kind", "beat_count"],
        "title": "ChronicleSummary",
        "type": "object"
      },
      "ChronicleDetail": {
        "properties": {
          "id": {
            "title": "Id",
            "type": "integer"
          },
          "title": {
            "title": "Title",
            "type": "string"
          },
          "kind": {
            "title": "Kind",
            "type": "string"
          },
          "last_t": {
            "title": "Last T",
            "type": "integer"
          },
          "players": {
            "items": {
              "$ref": "#/components/schemas/PlayerSummary"
            },
            "title": "Players",
            "type": "array"
          }
        },
        "required": ["id", "title", "kind", "last_t", "players"],
        "title": "ChronicleDetail",
        "type": "object"
      },
      "PlayerSummary": {
        "properties": {
          "id": {
            "title": "Id",
            "type": "integer"
          },
          "name": {
            "title": "Name",
            "type": "string"
          }
        },
        "required": ["id", "name"],
        "title": "PlayerSummary",
        "type": "object"
      },
      "BeatSummary": {
        "properties": {
          "t": {
            "title": "T",
            "type": "integer"
          },
          "pred": {
            "title": "Pred",
            "type": "string"
          },
          "text": {
            "title": "Text",
            "type": "string"
          },
          "source_kind": {
            "title": "Source Kind",
            "type": "string"
          },
          "quarantined": {
            "title": "Quarantined",
            "type": "boolean"
          }
        },
        "required": ["t", "pred", "text", "source_kind", "quarantined"],
        "title": "BeatSummary",
        "type": "object"
      }
    }
  },
  "servers": []
}
