{
  "openapi": "3.1.0",
  "info": {
    "title": "Chronicler",
    "version": "1.0.0",
    "description": ""
  },
  "paths": {
    "/api/chronicles/": {
      "get": {
        "operationId": "gm_ui_api_list_chronicles",
        "summary": "List Chronicles",
        "parameters": [],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/ChronicleSummary"
                  },
                  "title": "Response",
                  "type": "array"
                }
              }
            }
          }
        }
      }
    },
    "/api/chronicles/{chronicle_id}": {
      "get": {
        "operationId": "gm_ui_api_get_chronicle",
        "summary": "Get Chronicle",
        "parameters": [
          {
            "in": "path",
            "name": "chronicle_id",
            "schema": {
              "title": "Chronicle Id",
              "type": "integer"
            },
            "required": true
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChronicleDetail"
                }
              }
            }
          }
        }
      }
    },
    "/api/chronicles/{chronicle_id}/beats": {
      "get": {
        "operationId": "gm_ui_api_list_beats",
        "summary": "List Beats",
        "parameters": [
          {
            "in": "path",
            "name": "chronicle_id",
            "schema": {
              "title": "Chronicle Id",
              "type": "integer"
            },
            "required": true
          },
          {
            "in": "query",
            "name": "audience",
            "schema": {
              "default": "all",
              "title": "Audience",
              "type": "string"
            },
            "required": false
          },
          {
            "in": "query",
            "name": "t",
            "schema": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "title": "T"
            },
            "required": false
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/BeatSummary"
                  },
                  "title": "Response",
                  "type": "array"
                }
              }
            }
          }
        },
        "description": "The beats `audience` (\"all\", \"table\" or a player id) had seen up to t (default: the latest)."
      }
    },
    "/api/chronicles/{chronicle_id}/lattice": {
      "get": {
        "operationId": "gm_ui_lattice_api_get_lattice",
        "summary": "Get Lattice",
        "parameters": [
          {
            "in": "path",
            "name": "chronicle_id",
            "schema": {
              "title": "Chronicle Id",
              "type": "integer"
            },
            "required": true
          },
          {
            "in": "query",
            "name": "audience",
            "schema": {
              "default": "all",
              "title": "Audience",
              "type": "string"
            },
            "required": false
          },
          {
            "in": "query",
            "name": "t",
            "schema": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "title": "T"
            },
            "required": false
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LatticeOut"
                }
              }
            }
          }
        },
        "description": "The unfiltered lattice (\"all\", the GM's view) or one player's lattice at t (default: latest)."
      }
    }
  },
  "components": {
    "schemas": {
      "ChronicleSummary": {
        "properties": {
          "id": {
            "title": "Id",
            "type": "integer"
          },
          "title": {
            "title": "Title",
            "type": "string"
          },
          "kind": {
            "title": "Kind",
            "type": "string"
          },
          "beat_count": {
            "title": "Beat Count",
            "type": "integer"
          }
        },
        "required": ["id", "title", "kind", "beat_count"],
        "title": "ChronicleSummary",
        "type": "object"
      },
      "ChronicleDetail": {
        "properties": {
          "id": {
            "title": "Id",
            "type": "integer"
          },
          "title": {
            "title": "Title",
            "type": "string"
          },
          "kind": {
            "title": "Kind",
            "type": "string"
          },
          "last_t": {
            "title": "Last T",
            "type": "integer"
          },
          "players": {
            "items": {
              "$ref": "#/components/schemas/PlayerSummary"
            },
            "title": "Players",
            "type": "array"
          }
        },
        "required": ["id", "title", "kind", "last_t", "players"],
        "title": "ChronicleDetail",
        "type": "object"
      },
      "PlayerSummary": {
        "properties": {
          "id": {
            "title": "Id",
            "type": "integer"
          },
          "name": {
            "title": "Name",
            "type": "string"
          }
        },
        "required": ["id", "name"],
        "title": "PlayerSummary",
        "type": "object"
      },
      "BeatSummary": {
        "properties": {
          "t": {
            "title": "T",
            "type": "integer"
          },
          "pred": {
            "title": "Pred",
            "type": "string"
          },
          "text": {
            "title": "Text",
            "type": "string"
          },
          "source_kind": {
            "title": "Source Kind",
            "type": "string"
          },
          "quarantined": {
            "title": "Quarantined",
            "type": "boolean"
          }
        },
        "required": ["t", "pred", "text", "source_kind", "quarantined"],
        "title": "BeatSummary",
        "type": "object"
      },
      "BindingEntry": {
        "properties": {
          "role": {
            "title": "Role",
            "type": "string"
          },
          "entity_id": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Entity Id"
          },
          "entity_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Entity Name"
          }
        },
        "required": ["role", "entity_id", "entity_name"],
        "title": "BindingEntry",
        "type": "object"
      },
      "FilledStep": {
        "properties": {
          "step_id": {
            "title": "Step Id",
            "type": "string"
          },
          "beat_ts": {
            "items": {
              "type": "integer"
            },
            "title": "Beat Ts",
            "type": "array"
          }
        },
        "required": ["step_id", "beat_ts"],
        "title": "FilledStep",
        "type": "object"
      },
      "LatticeHypothesisOut": {
        "properties": {
          "id": {
            "title": "Id",
            "type": "integer"
          },
          "schema_slug": {
            "title": "Schema Slug",
            "type": "string"
          },
          "schema_name": {
            "title": "Schema Name",
            "type": "string"
          },
          "binding": {
            "items": {
              "$ref": "#/components/schemas/BindingEntry"
            },
            "title": "Binding",
            "type": "array"
          },
          "status": {
            "title": "Status",
            "type": "string"
          },
          "weight": {
            "title": "Weight",
            "type": "number"
          },
          "created_at_t": {
            "title": "Created At T",
            "type": "integer"
          },
          "status_changed_at_t": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Status Changed At T"
          },
          "filled_steps": {
            "items": {
              "$ref": "#/components/schemas/FilledStep"
            },
            "title": "Filled Steps",
            "type": "array"
          },
          "open_steps": {
            "items": {
              "type": "string"
            },
            "title": "Open Steps",
            "type": "array"
          },
          "refines": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Refines"
          },
          "voiced": {
            "title": "Voiced",
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "schema_slug",
          "schema_name",
          "binding",
          "status",
          "weight",
          "created_at_t",
          "status_changed_at_t",
          "filled_steps",
          "open_steps",
          "refines",
          "voiced"
        ],
        "title": "LatticeHypothesisOut",
        "type": "object"
      },
      "LatticeOut": {
        "properties": {
          "t": {
            "title": "T",
            "type": "integer"
          },
          "hypotheses": {
            "items": {
              "$ref": "#/components/schemas/LatticeHypothesisOut"
            },
            "title": "Hypotheses",
            "type": "array"
          }
        },
        "required": ["t", "hypotheses"],
        "title": "LatticeOut",
        "type": "object"
      }
    }
  },
  "servers": []
}
