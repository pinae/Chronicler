  "paths": {
    "/api/chronicles/": {
      "get": {
        "operationId": "gm_ui_api_list_chronicles",
        "summary": "List Chronicles",
        "parameters": [],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/ChronicleSummary"
                  },
                  "title": "Response",
                  "type": "array"
                }
              }
            }
          }
        }
      }
    },
    "/api/chronicles/{chronicle_id}": {
      "get": {
        "operationId": "gm_ui_api_get_chronicle",
        "summary": "Get Chronicle",
        "parameters": [
          {
            "in": "path",
            "name": "chronicle_id",
            "schema": {
              "title": "Chronicle Id",
              "type": "integer"
            },
            "required": true
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChronicleDetail"
                }
              }
            }
          }
        }
      }
    },
    "/api/chronicles/{chronicle_id}/beats": {
      "get": {
        "operationId": "gm_ui_api_list_beats",
        "summary": "List Beats",
        "parameters": [
          {
            "in": "path",
            "name": "chronicle_id",
            "schema": {
              "title": "Chronicle Id",
              "type": "integer"
            },
            "required": true
          },
          {
            "in": "query",
            "name": "audience",
            "schema": {
              "default": "all",
              "title": "Audience",
              "type": "string"
            },
            "required": false
          },
          {
            "in": "query",
            "name": "t",
            "schema": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "title": "T"
            },
            "required": false
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/BeatSummary"
                  },
                  "title": "Response",
                  "type": "array"
                }
              }
            }
          }
        },
        "description": "The beats `audience` (\"all\", \"table\" or a player id) had seen up to t (default: the latest)."
      }
    },
    "/api/chronicles/{chronicle_id}/lattice": {
      "get": {
        "operationId": "gm_ui_lattice_api_get_lattice",
        "summary": "Get Lattice",
        "parameters": [
          {
            "in": "path",
            "name": "chronicle_id",
            "schema": {
              "title": "Chronicle Id",
              "type": "integer"
            },
            "required": true
          },
          {
            "in": "query",
            "name": "audience",
            "schema": {
              "default": "all",
              "title": "Audience",
              "type": "string"
            },
            "required": false
          },
          {
            "in": "query",
            "name": "t",
            "schema": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "title": "T"
            },
            "required": false
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LatticeOut"
                }
              }
            }
          }
        },
        "description": "The unfiltered lattice (\"all\", the GM's view) or one player's lattice at t (default: latest)."
      }
    },
    "/api/chronicles/{chronicle_id}/hypotheses/{hypothesis_id}/expectations": {
      "get": {
        "operationId": "gm_ui_lattice_api_list_expectations",
        "summary": "List Expectations",
        "parameters": [
          {
            "in": "path",
            "name": "chronicle_id",
            "schema": {
              "title": "Chronicle Id",
              "type": "integer"
            },
            "required": true
          },
          {
            "in": "path",
            "name": "hypothesis_id",
            "schema": {
              "title": "Hypothesis Id",
              "type": "integer"
            },
            "required": true
          },
          {
            "in": "query",
            "name": "t",
            "schema": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "title": "T"
            },
            "required": false
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/ExpectationOut"
                  },
                  "title": "Response",
                  "type": "array"
                }
              }
            }
          }
        },
        "description": "Per open step, the latest readout at or before t (default: the latest) about this hypothesis."
      }
    },
