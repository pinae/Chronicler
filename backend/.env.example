# Copy to backend/.env for local development. Environment variables take precedence over this file.
DJANGO_SECRET_KEY=change-me
# The database of docker-compose.yml (`docker compose up -d` in the repository root).
DATABASE_URL=postgres://narrative:narrative@localhost:5432/narrative_engine

# The language model (docs/usage/ollama-smoke-check.md). Without it, use --reader uniform.
# OLLAMA_BASE_URL=http://gpu-box:11434
# OLLAMA_READER_MODEL=gemma3:12b
# OLLAMA_INGEST_MODEL=gemma3:12b
# OLLAMA_WRITER_MODEL=gemma3:12b
